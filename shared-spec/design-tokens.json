  "spacing": {
    "scale": {
      "0": 0,
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 20,
      "6": 24,
      "7": 28,
      "8": 32,
      "9": 36,
      "10": 40,
      "11": 44,
      "12": 48,
      "14": 56,
      "16": 64,
      "20": 80,
      "24": 96
    },
    "safeArea": {
      "top": "env(safe-area-inset-top)",
      "bottom": "env(safe-area-inset-bottom)",
      "horizontal": 20
    }
  },
  "radius": {
    "none": 0,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 22,
    "2xl": 28,
    "full": 9999
  },
  "elevation": {
    "level-0": {
      "ios": "none",
      "android": "0dp"
    },
    "level-1": {
      "ios": { "shadow": [{ "color": "#000000", "opacity": 0.08, "radius": 4, "y": 2 }, { "color": "#000000", "opacity": 0.04, "radius": 8, "y": 4 }] },
      "android": "1dp"
    },
    "level-2": {
      "ios": { "shadow": [{ "color": "#000000", "opacity": 0.12, "radius": 8, "y": 4 }, { "color": "#000000", "opacity": 0.06, "radius": 16, "y": 8 }] },
      "android": "3dp"
    },
    "level-3": {
      "ios": { "shadow": [{ "color": "#000000", "opacity": 0.16, "radius": 16, "y": 8 }, { "color": "#000000", "opacity": 0.08, "radius": 32, "y": 16 }] },
      "android": "6dp"
    },
    "level-4": {
      "ios": { "shadow": [{ "color": "#000000", "opacity": 0.24, "radius": 24, "y": 12 }, { "color": "#000000", "opacity": 0.12, "radius": 48, "y": 24 }] },
      "android": "8dp"
    },
    "level-5": {
      "ios": { "shadow": [{ "color": "#000000", "opacity": 0.32, "radius": 32, "y": 16 }, { "color": "#000000", "opacity": 0.16, "radius": 64, "y": 32 }] },
      "android": "12dp"
    }
  },
  "material": {
    "ios": {
      "regular": { "material": "regularMaterial", "tint": "neutral.400@10%" },
      "thin": { "material": "thinMaterial", "tint": "neutral.400@6%" },
      "innerStroke": { "color": "neutral.950@6%", "width": 0.5 }
    },
    "android": {
      "regular": { "tonalElevation": 3, "color": "neutral.400@90%" },
      "thin": { "tonalElevation": 1, "color": "neutral.400@85%" },
      "innerStroke": { "color": "neutral.950@4%", "width": 0.5 }
    }
  },
  "motion": {
    "springPresets": {
      "gentle": {
        "ios": { "mass": 1, "stiffness": 120, "damping": 24 },
        "android": { "dampingRatio": 0.85, "stiffness": 120 }
      },
      "default": {
        "ios": { "mass": 1, "stiffness": 200, "damping": 26 },
        "android": { "dampingRatio": 0.8, "stiffness": 200 }
      },
      "snappy": {
        "ios": { "mass": 1, "stiffness": 380, "damping": 32 },
        "android": { "dampingRatio": 0.7, "stiffness": 380 }
      },
      "bouncy": {
        "ios": { "mass": 1.2, "stiffness": 280, "damping": 14 },
        "android": { "dampingRatio": 0.5, "stiffness": 280 }
      }
    },
    "duration": {
      "instant": 0,
      "fast": 0.15,
      "normal": 0.25,
      "slow": 0.4,
      "deliberate": 0.6,
      "draw": 0.6
    },
    "stagger": {
      "tight": 0.03,
      "normal": 0.05,
      "loose": 0.08
    }
  },
  "haptics": {
    "ios": {
      "selection": { "generator": "UISelectionFeedbackGenerator", "trigger": "selectionChanged()" },
      "light": { "generator": "UIImpactFeedbackGenerator(style: .light)", "trigger": "impactOccurred()" },
      "medium": { "generator": "UIImpactFeedbackGenerator(style: .medium)", "trigger": "impactOccurred()" },
      "heavy": { "generator": "UIImpactFeedbackGenerator(style: .heavy)", "trigger": "impactOccurred()" },
      "success": { "generator": "UINotificationFeedbackGenerator", "trigger": "notificationOccurred(.success)" },
      "warning": { "generator": "UINotificationFeedbackGenerator", "trigger": "notificationOccurred(.warning)" },
      "error": { "generator": "UINotificationFeedbackGenerator", "trigger": "notificationOccurred(.error)" },
      "continuous": { "generator": "CoreHaptics (CHHapticEngine)", "pattern": "continuous texture with intensity modulation" }
    },
    "android": {
      "selection": { "constant": "HapticFeedbackConstants.CLOCK_TICK" },
      "light": { "constant": "HapticFeedbackConstants.CONTEXT_CLICK" },
      "medium": { "constant": "HapticFeedbackConstants.VIRTUAL_KEY" },
      "heavy": { "constant": "HapticFeedbackConstants.LONG_PRESS" },
      "success": { "constant": "HapticFeedbackConstants.CONFIRM" },
      "warning": { "constant": "HapticFeedbackConstants.REJECT" },
      "error": { "constant": "HapticFeedbackConstants.REJECT" },
      "continuous": { "api31": "VibrationEffect.Composition with PRIMITIVE_TICK and scaleIntensity" }
    },
    "mapping": {
      "tileTap": "light",
      "pickerScrub": "selection",
      "primaryCTA": "medium",
      "shareCopy": "success",
      "faultState": "warning",
      "connectionFailure": "error",
      "batteryThreshold80": "light",
      "batteryThreshold50": "medium",
      "batteryThreshold20": "heavy",
      "longPressTexture": "continuous"
    }
  }
}
