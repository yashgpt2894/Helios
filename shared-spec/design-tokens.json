  "typography": {
    "ios": {
      "family": {
        "display": "SF Pro Display",
        "text": "SF Pro Text",
        "rounded": "SF Pro Rounded",
        "mono": "SF Mono"
      },
      "scale": [
        { "token": "hero", "size": 56, "weight": 300, "lineHeight": 56, "tracking": -0.02, "opticalSize": 56, "font": "display" },
        { "token": "title-1", "size": 34, "weight": 400, "lineHeight": 40, "tracking": -0.01, "opticalSize": 34, "font": "display" },
        { "token": "title-2", "size": 28, "weight": 400, "lineHeight": 34, "tracking": -0.01, "opticalSize": 28, "font": "display" },
        { "token": "title-3", "size": 22, "weight": 400, "lineHeight": 28, "tracking": -0.01, "opticalSize": 22, "font": "display" },
        { "token": "headline", "size": 17, "weight": 600, "lineHeight": 22, "tracking": -0.01, "opticalSize": 17, "font": "text" },
        { "token": "body", "size": 16, "weight": 400, "lineHeight": 22, "tracking": -0.01, "opticalSize": 16, "font": "text" },
        { "token": "callout", "size": 14, "weight": 400, "lineHeight": 20, "tracking": -0.01, "opticalSize": 14, "font": "text" },
        { "token": "subheadline", "size": 13, "weight": 400, "lineHeight": 18, "tracking": -0.01, "opticalSize": 13, "font": "text" },
        { "token": "caption", "size": 11, "weight": 400, "lineHeight": 14, "tracking": 0.01, "opticalSize": 11, "font": "text" },
        { "token": "caption-2", "size": 10, "weight": 500, "lineHeight": 12, "tracking": 0.06, "opticalSize": 10, "font": "text" }
      ],
      "numeric": {
        "body": { "fontVariant": "proportional-oldstyle-figures" },
        "chartAxis": { "fontVariant": "tabular-lining-figures" },
        "liveTicker": { "fontVariant": "tabular-lining-figures" }
      }
    },
    "android": {
      "family": {
        "display": "Roboto Flex",
        "text": "Roboto Flex",
        "rounded": "Roboto Flex",
        "mono": "Roboto Mono"
      },
      "scale": [
        { "token": "hero", "size": 56, "weight": 300, "lineHeight": 56, "tracking": -0.02, "grade": 0, "font": "display" },
        { "token": "title-1", "size": 34, "weight": 400, "lineHeight": 40, "tracking": -0.01, "grade": 0, "font": "display" },
        { "token": "title-2", "size": 28, "weight": 400, "lineHeight": 34, "tracking": -0.01, "grade": 0, "font": "display" },
        { "token": "title-3", "size": 22, "weight": 400, "lineHeight": 28, "tracking": -0.01, "grade": 0, "font": "display" },
