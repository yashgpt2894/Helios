        { "token": "body", "size": 16, "weight": 400, "lineHeight": 22, "tracking": -0.01, "grade": 0, "font": "text" },
        { "token": "callout", "size": 14, "weight": 400, "lineHeight": 20, "tracking": -0.01, "grade": 0, "font": "text" },
        { "token": "subheadline", "size": 13, "weight": 400, "lineHeight": 18, "tracking": -0.01, "grade": 0, "font": "text" },
        { "token": "caption", "size": 11, "weight": 400, "lineHeight": 14, "tracking": 0.01, "grade": 0, "font": "text" },
        { "token": "caption-2", "size": 10, "weight": 500, "lineHeight": 12, "tracking": 0.06, "grade": 0, "font": "text" }
      ]
    }
